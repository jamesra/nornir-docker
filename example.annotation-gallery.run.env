# Copy to $NORNIR_DOCKER_USER_ROOT/Run/nornir-annotation-gallery/annotation-gallery.run.env
# Used by start-annotation-gallery.ps1 / compose.annotation-gallery.yaml.

# Bind the UI to localhost.
GALLERY_BIND_HOST=127.0.0.1

# Folder of volume-root links. Child name = Identity volume name.
# Example: ln -s /storage4/RC2 $GALLERY_VOLUME_DIR_HOST/RC2
GALLERY_VOLUME_DIR_HOST=/gallery-volumes-host

# Bind so those links resolve (volume roots live here, not AnnotationCrops).
GALLERY_STORAGE_HOST=/storage4

# stub | oidc  (oidc talks to identity.codepharm.net; stub is the P2 fixture)
GALLERY_IDENTITY_MODE=stub
GALLERY_STUB_ROLE=review
# Optional per-volume overrides: RC2:review,RPC1:read
GALLERY_STUB_GRANTS=

GALLERY_SESSION_SECRET=change-me

GALLERY_VIKING_URL=https://connectomes.utah.edu/connectome/{volume}#locationID={id}

# Live OIDC (GALLERY_IDENTITY_MODE=oidc). Do not put real secrets in git.
GALLERY_OIDC_AUTHORITY=https://identity.codepharm.net:5001
GALLERY_IDENTITY_API=https://identity.codepharm.net:6001
GALLERY_OIDC_CLIENT_ID=
GALLERY_OIDC_CLIENT_SECRET=
GALLERY_OIDC_REDIRECT_URI=http://127.0.0.1:8090/callback
GALLERY_READ_PERMISSION=Read
GALLERY_REVIEW_PERMISSION=Review
