# Machine-local (recommended): copy to
#   D:\Docker\Run\nornir-cursor-worker\nornir-cursor-worker.run.env
# Set NORNIR_CURSOR_WORKER_ENV_FILE to that path, or rely on start-cursor-worker.ps1 discovery.
#
# Dev fallback: nornir-docker/.env.cursor-worker (gitignored) for compose only.
# Or set NORNIR_CURSOR_WORKER_ENV_FILE explicitly.
#
# Required for the worker container:
CURSOR_API_KEY=

NORNIR_NET_CREDS_DIR_HOST=\\wsl.localhost\Ubuntu\mnt\d\Docker\Run\nornir-dev\secrets\net-creds
NORNIR_TESTDATA_HOST=\\wsl.localhost\Ubuntu\home\jamesan\nornir-testdata

# Optional: GitHub API access (private submodules, rate limits). Passed to container via --env-file only.
# GITHUB_TOKEN=

# Workspace strategy: clone | mounted
# NORNIR_WORKSPACE_STRATEGY=clone
# NORNIR_CLONE_URL=https://github.com/jamesra/nornir.git
# NORNIR_CLONE_BRANCH=dev
