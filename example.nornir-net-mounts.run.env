# Copy to $NORNIR_DOCKER_USER_ROOT/Run/nornir-net-mounts/.run.nornir-net-mounts.env (not committed).
# Shared by start-nornir-build.ps1, run-cursor-dev (net mounts), and worker -DevParityMounts.
#
# start-nornir-build.ps1 from PowerShell (recommended — no WSL integration / \\wsl.localhost\ needed):
#NORNIR_NET_MOUNTS_DIR_HOST=C:\Docker\Run\nornir-net-mounts\net-mounts
#NORNIR_NET_CREDS_DIR_HOST=C:\Users\<you>\.nornir\secrets\net-creds
# Both keys must be set when creds live outside the default secrets\net-creds tree.
#
# Optional — WSL UNC (requires Docker WSL integration; often fails with distro-services/*.sock):
#NORNIR_NET_MOUNTS_DIR_HOST=\\wsl.localhost\Ubuntu\mnt\c\Docker\Run\nornir-net-mounts\net-mounts
#NORNIR_NET_CREDS_DIR_HOST=\\wsl.localhost\Ubuntu\mnt\c\Docker\Run\nornir-net-mounts\secrets\net-creds
#
# Compose / docker run from a WSL shell:
#NORNIR_NET_MOUNTS_DIR_HOST=/mnt/c/Docker/Run/nornir-net-mounts/net-mounts
#NORNIR_NET_CREDS_DIR_HOST=/mnt/c/Docker/Run/nornir-net-mounts/secrets/net-creds

# Co-located dashboard: batch/interactive publishers reach Mosquitto via host or compose network.
# start-nornir-build.ps1 defaults MQTT host to host.docker.internal when unset.
NORNIR_MQTT_HOST=host.docker.internal
NORNIR_MQTT_PORT=1883
NORNIR_MQTT_ENABLE=1
