# nornir-dashboard (Mosquitto + build dashboard). Copy to <root>/Run/nornir-dashboard/nornir-dashboard.run.env.

# OPTIONAL  Keep both on loopback; reach the UI remotely with `stack.ps1 tunnel -Target compute`.
#           On Linux, Docker-published ports bypass ufw: do not widen these without a token and a firewall rule.
NORNIR_DASHBOARD_BIND_HOST=127.0.0.1
NORNIR_MQTT_BIND_HOST=127.0.0.1
# OPTIONAL  Required before widening NORNIR_DASHBOARD_BIND_HOST. Generate with
#           `stack.ps1 secrets new nornir-dashboard` (written to Run/nornir-dashboard/secrets/secrets.env).
#NORNIR_DASHBOARD_TOKEN=
# OPTIONAL  0 = disallow deleting runs from the UI.
NORNIR_DASHBOARD_ALLOW_DELETE=1
# OPTIONAL  Max SQLite events retained per run (0 = unlimited).
NORNIR_DASHBOARD_MAX_EVENTS=0
NORNIR_DASHBOARD_RETENTION_DAYS=30
# OPTIONAL  Seconds without events before a run is marked stale (<=0 falls back to 600).
NORNIR_DASHBOARD_STALE_AFTER=600
