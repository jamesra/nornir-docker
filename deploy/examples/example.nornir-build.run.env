# nornir-build (production build appliance). Copy to <root>/Run/nornir-build/nornir-build.run.env.
# CIFS shares come from <root>/Run/nornir-net-mounts/ (net-mounts/nas-mounts.tsv + secrets/net-creds/*.cred).

# OPTIONAL  Shared memory for the container (multiprocessing pools need far more than Docker's 64 MB default).
NORNIR_DOCKER_SHM_SIZE=64g
# OPTIONAL  Open-file limit inside the container.
NORNIR_DOCKER_NOFILE_SOFT=65536
NORNIR_DOCKER_NOFILE_HARD=65536
# OPTIONAL  1 = force --gpus all; unset = auto-detect with Test-NornirGpu.ps1 (nornir:cupy if a GPU works, else nornir:prod).
#NORNIR_DOCKER_GPU=1
# OPTIONAL  Publish build progress to the co-located dashboard. Leave NORNIR_MQTT_HOST unset to
#           join the nornir-dashboard_default network automatically (broker host name: mosquitto).
NORNIR_MQTT_ENABLE=1
#NORNIR_MQTT_HOST=mosquitto
#NORNIR_MQTT_PORT=1883
# OPTIONAL  1 = publish 127.0.0.1:5678 for debugpy (reach it from the dev box with `stack.ps1 tunnel -Target compute`).
#           debugpy is not baked into the images: inside the container run
#           python -m pip install debugpy && python -m debugpy --listen 0.0.0.0:5678 --wait-for-client -m nornir_buildmanager.build ...
#NORNIR_DEBUGPY=1
#NORNIR_DEBUGPY_PORT=5678
# OPTIONAL  Extra docker run arguments (space separated).
#NORNIR_DOCKER_EXTRA_ARGS=
