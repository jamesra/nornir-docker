# Machine settings for every stack on this host.
# Copy to <root>/Run/_host/host.env (Initialize-DockerHost.ps1 does this). Not in git.
# <root> = NORNIR_DOCKER_USER_ROOT: D:\Docker on Windows, /srv/docker on Ubuntu.
# Secrets do NOT go here: use Run/_host/secrets/secrets.env (machine-wide) or
# Run/<stack>/secrets/secrets.env (per stack).

# --- Layout and checkouts ---------------------------------------------------
# REQUIRED  Layout root (holds Run/, Data/, Certs/ ...). Filled in by Initialize-DockerHost.ps1.
NORNIR_DOCKER_USER_ROOT=
# REQUIRED  nornir monorepo checkout on THIS host (e.g. /srv/src/nornir or D:\src\git\nornir).
NORNIR_REPO_ROOT_HOST=
# OPTIONAL  Viking checkout on THIS host (required for any viking-* stack).
VIKING_REPO_ROOT_HOST=
# REQUIRED  Stacks this host runs; `stack.ps1 all <action>` acts on these, in this order.
#           compute: nornir-build,nornir-dashboard,viking-segmentation
#           web:     viking-proxy,viking-certs,viking-identity,viking-annotation,viking-corrections
#           (the SAM2 gallery is started from the Sam2Trainer repo; the proxy still routes its names)
NORNIR_DOCKER_HOST_STACKS=

# --- Public names -----------------------------------------------------------
# REQUIRED (Viking hosts)  Parent domain. Each service is <sub>.$VIKING_DOMAIN unless overridden below.
VIKING_DOMAIN=connectomes.pitt.edu
# OPTIONAL  Per-service overrides (defaults shown). Keep them single-label so one *.domain
#           wildcard certificate covers every name.
#VIKING_HOSTNAME_IDENTITY=identity.connectomes.pitt.edu
#VIKING_HOSTNAME_WEBSVC=websvc.connectomes.pitt.edu
#VIKING_HOSTNAME_ANNOTATION=annotation.connectomes.pitt.edu
#VIKING_HOSTNAME_CORRECTIONS=corrections.connectomes.pitt.edu
#VIKING_HOSTNAME_SEGMENTATION=segmentation.connectomes.pitt.edu
#VIKING_HOSTNAME_SEGMENTATIONDEMO=segmentationdemo.connectomes.pitt.edu
#VIKING_HOSTNAME_SEG_V3=segmentation-v3.connectomes.pitt.edu
#VIKING_HOSTNAME_SEG_V4=segmentation-v4.connectomes.pitt.edu
#VIKING_HOSTNAME_SEG_SEM_V1=segmentation-sem-v1.connectomes.pitt.edu
#VIKING_HOSTNAME_GALLERY=gallery.connectomes.pitt.edu
#VIKING_HOSTNAME_TEM_GALLERY=gallery-tem.connectomes.pitt.edu
#VIKING_HOSTNAME_SEM_GALLERY=gallery-sem.connectomes.pitt.edu

# --- Proxy upstreams (web host) ------------------------------------------------
# REQUIRED (web host)  LAN name or IP of the GPU compute host, as the proxy reaches it (segmentation*).
VIKING_COMPUTE_HOST=
# REQUIRED (web host)  LAN name or IP of the legacy Windows IIS host (websvc).
VIKING_IIS_HOST=
# OPTIONAL  host:port for SNI names the proxy does not recognise (default: the IIS host on 443).
#VIKING_UPSTREAM_DEFAULT=
# OPTIONAL  host:port to pass plain-HTTP websvc traffic straight through on port 80 instead of
#           redirecting it to HTTPS (keeps old Viking clients' http:// WCF/tile requests working).
#VIKING_HTTP_UPSTREAM_WEBSVC=

# --- TLS (one certificate for every name; docs: deployment/tls) ----------------
# REQUIRED (Viking hosts)  letsencrypt | acme-eab | manual
TLS_MODE=letsencrypt
# REQUIRED for letsencrypt/acme-eab  Contact address for expiry notices (Let's Encrypt needs no account or token).
TLS_EMAIL=
# OPTIONAL  Folder name under Certs/ (default: $VIKING_DOMAIN).
#TLS_CERT_NAME=connectomes.pitt.edu
# OPTIONAL  Comma list of names the cert must cover (default: every VIKING_HOSTNAME_*).
#TLS_HOSTNAMES=
# OPTIONAL  acme-eab only: ACME directory URL supplied by Pitt IT (InCommon / Sectigo).
#           The EAB key id and HMAC key go in Run/viking-certs/secrets/secrets.env.
#TLS_ACME_SERVER=
# OPTIONAL  1 = Let's Encrypt staging endpoint (untrusted certs; use while testing to avoid rate limits).
TLS_STAGING=0
# OPTIONAL  Password for Certs/<name>/cert.pfx (IIS import). Empty = no password.
#TLS_PFX_PASSWORD=

# --- Images -------------------------------------------------------------------
# OPTIONAL  GitHub owner of ghcr.io/<owner>/nornir:* images (docker-pull.ps1 / stack.ps1 pull).
NORNIR_GHCR_OWNER=jamesra
