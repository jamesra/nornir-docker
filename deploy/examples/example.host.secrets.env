# Machine-wide secrets. Copy to <root>/Run/_host/secrets/secrets.env (chmod 600). Not in git.

# OPTIONAL  GitHub fine-grained personal access token
#           (github.com > Settings > Developer settings > Personal access tokens > Fine-grained).
#           Servers:  Packages: read (ghcr.io pulls); Contents: read on jamesra/nornir and
#                     jamesra/Viking only if those repositories are private.
#           Dev box:  Packages: read and write (docker-push.ps1).
#           Also run once per host:  docker login ghcr.io -u <github-user>   (password = this token)
GITHUB_TOKEN=
