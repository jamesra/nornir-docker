# Copy to $NORNIR_DOCKER_USER_ROOT/Run/nornir-dashboard/dashboard.run.env (not committed).
# Used by start-dashboard.ps1 / Initialize-NornirBuildAppliance.ps1 with compose.dashboard.yaml.

# Bind dashboard UI and MQTT to localhost (co-located appliance).
NORNIR_DASHBOARD_BIND_HOST=127.0.0.1
NORNIR_MQTT_BIND_HOST=127.0.0.1

# Max SQLite events retained per run (0 = no prune / unlimited; default).
NORNIR_DASHBOARD_MAX_EVENTS=0
NORNIR_DASHBOARD_RETENTION_DAYS=30
# Stale sweep is always on; <=0 is rejected and falls back to 600.
NORNIR_DASHBOARD_STALE_AFTER=600
