# Copy to nornir-docker/.env (Compose variable substitution for compose.cursor-dev.yaml) or to
# $NORNIR_DOCKER_USER_ROOT/dev/cursor-dev.run.env — see nornir-docker/README.md.
# Set the path to your test input on the WSL2 filesystem.
# Use `echo $HOME` in WSL to pick a path under your Linux home (not /mnt/c/...).
#
# Example:
#   NORNIR_TESTDATA_HOST=/home/youruser/nornir-testdata
NORNIR_TESTDATA_HOST=/home/youruser/nornir-testdata

# Optional: WSL/Linux path to the large reproduction dataset tree (mirrors Windows D:\Data).
# Mounted read-only at /data. Compose sets INPUT_NORNIR_DATA=/data in the container.
# If unset, compose uses nornir-docker/dev/repro-data-mount-placeholder (empty /data).
# Example after copying corpus to Linux home:
#   NORNIR_REPRO_DATA_HOST=/home/youruser/data
#NORNIR_REPRO_DATA_HOST=

# Optional: NAS Volumes bind at /volumes and /storage4 (compose.cursor-dev.yaml; same source).
# Mount the share in WSL first (nornir-docker/dev/example.mount-volumes-wsl.sh).
# Docker Desktop on Windows — UNC to WSL mount:
#   NORNIR_VOLUMES_HOST=\\wsl.localhost\Ubuntu\mnt\nornir-volumes
# Compose from WSL shell only:
#   NORNIR_VOLUMES_HOST=/mnt/nornir-volumes
# See nornir-docker/windows-docker-layout/NORNIR_DEV_VOLUMES.md.
#NORNIR_VOLUMES_HOST=\\wsl.localhost\Ubuntu\mnt\nornir-volumes

# Optional: fast in-container CIFS/NFS (one hop NAS->container). Requires:
#   - compose.net-mounts.override.yaml (CAP_SYS_ADMIN + binds)
#   - rebuilt image with cifs-utils + mount-network-shares.sh
#   - cifs loaded on WSL host (grep cifs /proc/filesystems)
#NORNIR_NET_MOUNTS_DIR_HOST=\\wsl.localhost\Ubuntu\mnt\d\Docker\Run\nornir-dev\net-mounts
#NORNIR_NET_CREDS_DIR_HOST=\\wsl.localhost\Ubuntu\mnt\d\Docker\Run\nornir-dev\secrets\net-creds

# Legacy SCI SVN tree (read-only): bind-mounted at /legacycode.
# Default in compose: D:/src/SVN/SCI/trunk. When running Compose from WSL, prefer the Linux path, e.g.:
#   NORNIR_LEGACY_CODE_HOST=/mnt/d/src/SVN/SCI/trunk
#NORNIR_LEGACY_CODE_HOST=D:/src/SVN/SCI/trunk

# Test output (writable): bind-mounted at /tmp/nornir-test-output (TESTOUTPUTPATH).
# Default in compose: D:/nornir-test-output. Create the folder on the host if needed.
# When running Compose from WSL, prefer the Linux path, e.g.:
#   NORNIR_TESTOUTPUT_HOST=/mnt/d/nornir-test-output
#NORNIR_TESTOUTPUT_HOST=D:/nornir-test-output

# Import cache: redirects .pickle and ContrastOverrides.txt out of read-only TESTINPUTPATH.
# Mirrors TESTINPUTPATH directory structure under the cache root.
# Default: /tmp/nornir-test-output/ImportCache (inside the TESTOUTPUTPATH bind-mount).
#NORNIR_IMPORT_CACHE_PATH=/tmp/nornir-test-output/ImportCache

# Optional: bind source for cursor-dev (default service). Relative paths resolve from the
# compose file directory (nornir-docker/), so ".." is the monorepo root. Use an absolute host
# path when Docker must see a path outside that default (set in .env or the shell environment).
#NORNIR_WORKSPACE_HOST=..

# Optional: clone URL/branch for empty /workspace (mounted) or for cursor-dev-clone (named volume).
NORNIR_CLONE_URL=https://github.com/jamesra/nornir.git
NORNIR_CLONE_BRANCH=dev

# Optional: set to 1 in the container environment so cursor-dev (bind mount) runs checkout + pull
# to NORNIR_CLONE_BRANCH on every start. Not set by compose by default.
#NORNIR_SYNC_REMOTE=1

# Isolated clone + named volume: use Compose service cursor-dev-clone, run-cursor-dev.ps1 -Clone,
# or Dev Containers configuration "Nornir (cursor-dev clone)" (.devcontainer/cursor-dev-clone/devcontainer.json).
