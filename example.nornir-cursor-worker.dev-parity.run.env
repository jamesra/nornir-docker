# Optional fragment — merge into D:\Docker\Run\nornir-cursor-worker\nornir-cursor-worker.run.env
# (or copy lines below). NOT enabled in the default worker template.
#
# When set, start-cursor-worker.ps1 bind-mounts the same paths as cursor-dev, reading host paths from:
#   $NORNIR_DOCKER_USER_ROOT/Run/nornir-dev/.run.nornir-dev.env  (primary)
#   $NORNIR_MONOREPO_ROOT/nornir-docker/.env                       (fallback)
# Configure nornir-dev first: nornir-docker/windows-docker-layout/NORNIR_DEV_VOLUMES.md
#
# NORNIR_WORKER_DEV_PARITY_MOUNTS=1
